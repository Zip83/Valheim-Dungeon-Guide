<Project>
  <Target Name="VerifyCodeStyle"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectExtension)' == '.csproj'">
    <PropertyGroup>
      <_StyleCheckDotNetHost>$(DOTNET_HOST_PATH)</_StyleCheckDotNetHost>
      <_StyleCheckDotNetHost Condition="'$(_StyleCheckDotNetHost)' == ''">dotnet</_StyleCheckDotNetHost>
    </PropertyGroup>

    <Exec Command="&quot;$(_StyleCheckDotNetHost)&quot; format style &quot;$(MSBuildProjectFullPath)&quot; --no-restore --verify-no-changes --severity error"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
  <Import Project="build/GeneratePluginBuild.targets" />
</Project>
